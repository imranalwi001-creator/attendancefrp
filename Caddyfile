# ==============================================================================
# CADDY REVERSE PROXY CONFIGURATION - PT FAWWAZ RESKI PERWIRA
# Otomatisasi HTTPS Resmi Let's Encrypt / ZeroSSL
# ==============================================================================

# Domain Utama & Subdomain WWW Resmi
fawwazreskiperwira.com, www.fawwazreskiperwira.com {
    handle /api/* {
        reverse_proxy hrm-backend:5000
    }

    handle /downloads/* {
        reverse_proxy hrm-backend:5000
    }

    handle /wa-* {
        reverse_proxy hrm-wa-gateway:5002
    }

    handle /qr* {
        reverse_proxy hrm-wa-gateway:5002
    }

    handle {
        reverse_proxy hrm-frontend:80
    }

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
    }
}

# Fallback Wildcard & Port 80 HTTP Biasa
103.197.188.211.nip.io, :80 {
    handle /api/* {
        reverse_proxy hrm-backend:5000
    }

    handle /downloads/* {
        reverse_proxy hrm-backend:5000
    }

    handle /wa-* {
        reverse_proxy hrm-wa-gateway:5002
    }

    handle /qr* {
        reverse_proxy hrm-wa-gateway:5002
    }

    handle {
        reverse_proxy hrm-frontend:80
    }

    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
    }
}
