# ==============================================================================
# CADDY REVERSE PROXY CONFIGURATION
# Otomatisasi HTTP & HTTPS untuk Akses Web, HP, PWA & Kamera
# ==============================================================================

{
    auto_https disable_redirects
}

# HTTP Handler (Port 80)
http://103.197.188.211, :80 {
    handle /api/* {
        reverse_proxy hrm-backend:5000
    }

    handle {
        reverse_proxy hrm-frontend:80
    }

    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
    }
}

# HTTPS Handler (Port 443) dengan Internal TLS untuk IP Address
https://103.197.188.211, :443 {
    tls internal

    handle /api/* {
        reverse_proxy hrm-backend:5000
    }

    handle {
        reverse_proxy hrm-frontend:80
    }

    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
    }
}
