# ==============================================================================
# CADDY REVERSE PROXY CONFIGURATION
# Otomatisasi HTTPS Resmi via nip.io & Akses HTTP Langsung
# ==============================================================================

# 1. Domain Otomatis Resmi HTTPS (Sertifikat SSL Let's Encrypt Gratis Otomatis)
# Memungkinkan Akses Kamera HP, GPS, & PWA tanpa peringatan keamanan
103.197.188.211.nip.io {
    handle /api/* {
        reverse_proxy hrm-backend:5000
    }

    handle {
        reverse_proxy hrm-frontend:80
    }

    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
    }
}

# 2. Port 80 HTTP Biasa (Akses Langsung via IP)
:80 {
    handle /api/* {
        reverse_proxy hrm-backend:5000
    }

    handle {
        reverse_proxy hrm-frontend:80
    }

    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
    }
}
